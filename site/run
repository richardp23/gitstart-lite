#!/usr/bin/env bash
# GitStart Lite bootstrap launcher.
# Downloads a versioned release, verifies checksum when possible, and runs it.

set -u
set -o pipefail

BASE_URL="${GITSTART_BASE_URL:-https://richardp23.github.io/gitstart-lite}"
STABLE_FILE="${BASE_URL}/stable.txt"

# Return 0 when Git Bash or MSYS is likely on Windows.
boot_is_windows_shell() {
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*|CYGWIN*) return 0 ;;
    esac
    return 1
}

# Print a bootstrap warning to stderr (safe when stdout is captured).
boot_warn() {
    printf '%s\n' "$*" >&2
}

# Resolve a command to an absolute path when possible. Print path or name.
boot_resolve_bin() {
    local name="$1"
    local resolved
    if resolved="$(command -v "${name}" 2>/dev/null)" && [ -n "${resolved}" ]; then
        printf '%s\n' "${resolved}"
        return 0
    fi
    printf '%s\n' "${name}"
    return 1
}

# Try one curl binary. Return 0 on success.
# Extra curl flags may follow dest.
boot_try_curl_bin() {
    local bin="$1"
    local url="$2"
    local dest="$3"
    shift 3
    if [ ! -x "${bin}" ] && ! command -v "${bin}" >/dev/null 2>&1; then
        return 1
    fi
    if [ "${dest}" = "-" ]; then
        "${bin}" "$@" -fsSL "${url}" 2>/dev/null
        return $?
    fi
    "${bin}" "$@" -fsSL "${url}" -o "${dest}" 2>/dev/null
}

# Download a URL to a file or stdout.
# Windows order: normal curl, Windows curl.exe, other transports,
# then --ssl-no-revoke only as a TLS fallback.
boot_download() {
    local url="$1"
    local dest="$2"
    local win_curl="/c/Windows/System32/curl.exe"
    local curl_bin
    local curl_path
    local win_path

    if boot_is_windows_shell; then
        curl_bin="$(boot_resolve_bin curl)"
        curl_path="${curl_bin}"
        win_path="${win_curl}"

        # 1) Normal curl (PATH).
        if boot_try_curl_bin curl "${url}" "${dest}"; then
            return 0
        fi

        # 2) Windows curl.exe when it is a different executable.
        if [ -x "${win_curl}" ] || command -v "${win_curl}" >/dev/null 2>&1; then
            if [ "${curl_path}" != "${win_path}" ]; then
                if boot_try_curl_bin "${win_curl}" "${url}" "${dest}"; then
                    return 0
                fi
            fi
        fi

        # 3) Other normal transports.
        if command -v wget >/dev/null 2>&1; then
            if [ "${dest}" = "-" ]; then
                if wget -q -O - "${url}" 2>/dev/null; then
                    return 0
                fi
            else
                if wget -q -O "${dest}" "${url}" 2>/dev/null; then
                    return 0
                fi
                rm -f "${dest}" 2>/dev/null || true
            fi
        fi
        if command -v powershell.exe >/dev/null 2>&1 && [ "${dest}" != "-" ]; then
            powershell.exe -NoProfile -Command \
                "Invoke-WebRequest -Uri '${url}' -OutFile '${dest}' -UseBasicParsing" \
                >/dev/null 2>&1
            if [ -s "${dest}" ]; then
                return 0
            fi
            rm -f "${dest}" 2>/dev/null || true
        fi

        # 4) curl with --ssl-no-revoke only after normal TLS attempts fail.
        if boot_try_curl_bin curl "${url}" "${dest}" --ssl-no-revoke; then
            boot_warn "[WARNING] Used curl --ssl-no-revoke after normal TLS failed."
            boot_warn "Certificate revocation was not checked for this download."
            boot_warn "Code: GS-BOOT-002"
            return 0
        fi
        if [ -x "${win_curl}" ] || command -v "${win_curl}" >/dev/null 2>&1; then
            if [ "${curl_path}" != "${win_path}" ]; then
                if boot_try_curl_bin "${win_curl}" "${url}" "${dest}" --ssl-no-revoke; then
                    boot_warn "[WARNING] Used Windows curl.exe --ssl-no-revoke after normal TLS failed."
                    boot_warn "Certificate revocation was not checked for this download."
                    boot_warn "Code: GS-BOOT-002"
                    return 0
                fi
            fi
        fi
        return 1
    fi

    if boot_try_curl_bin curl "${url}" "${dest}"; then
        return 0
    fi
    if command -v wget >/dev/null 2>&1; then
        if [ "${dest}" = "-" ]; then
            wget -q -O - "${url}"
            return $?
        fi
        wget -q -O "${dest}" "${url}"
        return $?
    fi
    return 1
}

boot_print_download_help() {
    local app_url="$1"
    local sum_url="$2"
    printf 'Download failed on this machine or network.\n' >&2
    printf 'Code: GS-BOOT-002\n' >&2
    printf '\n' >&2
    printf 'Try one of these safe options:\n' >&2
    printf '\n' >&2
    printf '1) Browser download\n' >&2
    printf '   %s\n' "${app_url}" >&2
    printf '   %s\n' "${sum_url}" >&2
    printf '   Then in Git Bash: sha256sum -c gitstart.sh.sha256 && bash gitstart.sh\n' >&2
    printf '\n' >&2
    printf '2) PowerShell (Windows)\n' >&2
    printf "   powershell -Command \"Invoke-WebRequest -Uri '%s' -OutFile gitstart.sh\"\n" "${app_url}" >&2
    printf "   powershell -Command \"Invoke-WebRequest -Uri '%s' -OutFile gitstart.sh.sha256\"\n" "${sum_url}" >&2
    printf '   Then in Git Bash: sha256sum -c gitstart.sh.sha256 && bash gitstart.sh\n' >&2
    printf '\n' >&2
    printf '3) Outer curl with --ssl-no-revoke (Windows, when the one-line launch fails before bootstrap)\n' >&2
    printf '   bash -c "$(curl -fsSL --ssl-no-revoke %s/run)"\n' "${BASE_URL}" >&2
    printf '\n' >&2
    printf 'See %s/docs/troubleshooting.html\n' "${BASE_URL}" >&2
}

read_stable_version() {
    local raw
    if ! raw="$(boot_download "${STABLE_FILE}" "-")"; then
        printf '[ERROR] Could not download stable.txt.\n' >&2
        printf 'URL: %s\n' "${STABLE_FILE}" >&2
        printf 'See %s/docs/troubleshooting.html\n' "${BASE_URL}" >&2
        return 1
    fi
    raw="$(printf '%s' "${raw}" | tr -d '\r\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    if [ -z "${raw}" ]; then
        printf '[ERROR] stable.txt was empty.\n' >&2
        printf 'URL: %s\n' "${STABLE_FILE}" >&2
        printf 'See %s/docs/troubleshooting.html\n' "${BASE_URL}" >&2
        return 1
    fi
    case "${raw}" in
        v*) printf '%s\n' "${raw}" ;;
        *) printf 'v%s\n' "${raw}" ;;
    esac
}

confirm_without_checksum() {
    local answer
    printf '[WARNING] No SHA-256 command was found on this system.\n'
    printf 'The download cannot be verified automatically.\n'
    printf 'Continue without checksum verification? [y/N]: '
    if ! read -r answer; then
        return 1
    fi
    case "${answer}" in
        y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

# Remove only the temporary directory created by this bootstrap.
# Safe when called more than once.
cleanup() {
    local dir="${GS_TMP_DIR:-}"
    GS_TMP_DIR=""
    if [ -n "${dir}" ] && [ -d "${dir}" ]; then
        rm -rf -- "${dir}"
    fi
}
trap cleanup EXIT INT TERM HUP

if ! VERSION="$(read_stable_version)"; then
    exit 1
fi
VERSION="${VERSION#v}"
APP_URL="${BASE_URL}/releases/v${VERSION}/gitstart.sh"
SUM_URL="${BASE_URL}/releases/v${VERSION}/gitstart.sh.sha256"

if command -v mktemp >/dev/null 2>&1; then
    GS_TMP_DIR="$(mktemp -d 2>/dev/null || mktemp -d -t gitstart)"
else
    GS_TMP_DIR="/tmp/gitstart-$$"
    mkdir -p "${GS_TMP_DIR}"
fi

GS_TMP_APP="${GS_TMP_DIR}/gitstart.sh"
GS_TMP_SUM="${GS_TMP_DIR}/gitstart.sh.sha256"
GS_BOOT_STATUS=0

printf '[INFO] GitStart Lite bootstrap\n'
printf '[INFO] Version: v%s\n' "${VERSION}"
printf '[INFO] Source: %s\n' "${APP_URL}"

if ! boot_download "${APP_URL}" "${GS_TMP_APP}"; then
    printf '[ERROR] Download failed.\n' >&2
    boot_print_download_help "${APP_URL}" "${SUM_URL}"
    exit 1
fi

chmod +x "${GS_TMP_APP}" 2>/dev/null || true

if command -v sha256sum >/dev/null 2>&1; then
    if ! boot_download "${SUM_URL}" "${GS_TMP_SUM}"; then
        printf '[ERROR] Checksum file download failed.\n' >&2
        boot_print_download_help "${APP_URL}" "${SUM_URL}"
        exit 1
    fi
    (
        cd "${GS_TMP_DIR}" || exit 1
        sha256sum -c "gitstart.sh.sha256"
    ) || {
        printf '[ERROR] Checksum verification failed.\n' >&2
        printf 'Do not run the downloaded file.\n' >&2
        printf 'Code: GS-BOOT-001\n' >&2
        exit 1
    }
elif command -v shasum >/dev/null 2>&1; then
    if ! boot_download "${SUM_URL}" "${GS_TMP_SUM}"; then
        printf '[ERROR] Checksum file download failed.\n' >&2
        boot_print_download_help "${APP_URL}" "${SUM_URL}"
        exit 1
    fi
    (
        cd "${GS_TMP_DIR}" || exit 1
        shasum -a 256 -c "gitstart.sh.sha256"
    ) || {
        printf '[ERROR] Checksum verification failed.\n' >&2
        printf 'Do not run the downloaded file.\n' >&2
        printf 'Code: GS-BOOT-001\n' >&2
        exit 1
    }
else
    if ! confirm_without_checksum; then
        printf '[STOPPED] Bootstrap stopped without checksum verification.\n'
        printf 'Code: GS-BOOT-001\n'
        exit 1
    fi
fi

# Run the application in this shell so the EXIT trap can remove GS_TMP_DIR.
# Do not use exec: exec replaces the shell and skips normal EXIT cleanup.
bash "${GS_TMP_APP}" "$@"
GS_BOOT_STATUS=$?
exit "${GS_BOOT_STATUS}"
